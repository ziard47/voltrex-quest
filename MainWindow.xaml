<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="voltrex_quest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Voltrex Quest">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native Windows 11 Custom Title Bar -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0,140,0"
            VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image
                    Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png"
                    Width="20"
                    Height="20" />
                <TextBlock
                    Text="Voltrex Quest"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Primary Navigation Shell -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Auto"
            IsBackEnabled="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
            IsSettingsVisible="True"
            OpenPaneLength="236"
            SelectionChanged="NavView_SelectionChanged"
            BackRequested="NavView_BackRequested">

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="ShellSearchBox"
                    PlaceholderText="Search games..."
                    QueryIcon="Find"
                    QuerySubmitted="ShellSearchBox_QuerySubmitted" />
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Discover Games" Tag="discover">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="My Games" Tag="library">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Value="{x:Bind ViewModel.LibraryCount, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.LibraryBadgeVisibility, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </NavigationView>
    </Grid>
</Window>
