<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="voltrex_quest.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:voltrex_quest.Controls"
    xmlns:models="using:voltrex_quest.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24,32,32" Spacing="28" MaxWidth="1280" HorizontalAlignment="Stretch">
            <!-- Header / Welcome -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock
                        Text="Welcome back"
                        Style="{ThemeResource TitleLargeTextBlockStyle}" />
                    <TextBlock
                        Text="Browse Discord Quest-supported titles, organize your personal library, and launch game sessions directly."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <Button
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.OpenDiscoverCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE721;" FontSize="14" />
                            <TextBlock Text="Discover Games" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.OpenLibraryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7FC;" FontSize="14" />
                            <TextBlock Text="My Games" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Live Feedback InfoBar -->
            <InfoBar
                x:Name="ActionInfoBar"
                IsOpen="False"
                IsClosable="True" />

            <!-- Statistics Row -->
            <Grid ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Library Games -->
                <Border
                    Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,16">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="MY LIBRARY"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.TotalLibraryGames, Mode=OneWay}"
                            Style="{ThemeResource TitleLargeTextBlockStyle}" />
                        <TextBlock
                            Text="Saved personal games"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Catalog Games -->
                <Border
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,16">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="AVAILABLE CATALOG"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                Text="{x:Bind ViewModel.AvailableCatalogGames, Mode=OneWay}"
                                Style="{ThemeResource TitleLargeTextBlockStyle}" />
                            <ProgressRing
                                IsActive="{x:Bind ViewModel.IsCatalogLoading, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsCatalogLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock
                            Text="Entries in gamelist.json"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Windows Supported -->
                <Border
                    Grid.Column="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,16">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="WINDOWS SUPPORTED"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.WindowsSupportedGames, Mode=OneWay}"
                            Style="{ThemeResource TitleLargeTextBlockStyle}" />
                        <TextBlock
                            Text="Win32 detectable titles"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Recorded Sessions -->
                <Border
                    Grid.Column="3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,16">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="LAUNCHED SESSIONS"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.TotalSessionsCount, Mode=OneWay}"
                            Style="{ThemeResource TitleLargeTextBlockStyle}" />
                        <TextBlock
                            Text="Tracked launches"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recently Played -->
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="Recently Played" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <HyperlinkButton
                        Content="Open My Games"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.OpenLibraryCommand}" />
                </Grid>

                <Border
                    Visibility="{x:Bind ViewModel.HasRecentlyPlayed, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24,20">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE768;"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="No recent game sessions" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="Launch a game from My Games to see your recent activity here."
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsRepeater
                    ItemsSource="{x:Bind ViewModel.RecentlyPlayedGames}"
                    Visibility="{x:Bind ViewModel.HasRecentlyPlayed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="280" MinItemHeight="84" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:LibraryGame">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <controls:GameCoverImage
                                        Width="56"
                                        Height="56"
                                        CornerRadius="6"
                                        ImageUrl="{x:Bind CoverImageUrl, Mode=OneWay}"
                                        FallbackInitials="{x:Bind Initials}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Text="{x:Bind Name}"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1" />
                                        <TextBlock
                                            Text="{x:Bind LastPlayedDisplay, Mode=OneWay}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind PlayCountDisplay, Mode=OneWay}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Tag="{x:Bind}"
                                        Click="PlayQuickButton_Click"
                                        ToolTipService.ToolTip="Launch game">
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="13" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- Recently Added -->
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="Recently Added" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <HyperlinkButton
                        Content="Browse Catalog"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.OpenDiscoverCommand}" />
                </Grid>

                <Border
                    Visibility="{x:Bind ViewModel.HasRecentlyAdded, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24,20">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Glyph="&#xE8F1;"
                                FontSize="20"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="Your personal library is empty" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="Discover supported games from gamelist.json and add your favorites."
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Content="Discover Games"
                            Command="{x:Bind ViewModel.OpenDiscoverCommand}" />
                    </Grid>
                </Border>

                <ItemsRepeater
                    ItemsSource="{x:Bind ViewModel.RecentlyAddedGames}"
                    Visibility="{x:Bind ViewModel.HasRecentlyAdded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="280" MinItemHeight="84" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:LibraryGame">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <controls:GameCoverImage
                                        Width="56"
                                        Height="56"
                                        CornerRadius="6"
                                        ImageUrl="{x:Bind CoverImageUrl, Mode=OneWay}"
                                        FallbackInitials="{x:Bind Initials}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Text="{x:Bind Name}"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1" />
                                        <TextBlock
                                            Text="{x:Bind ThemesSummary}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind AddedAtDisplay}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Tag="{x:Bind}"
                                        Click="PlayQuickButton_Click"
                                        ToolTipService.ToolTip="Launch game">
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="13" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- Recent Sessions History -->
            <StackPanel Spacing="12">
                <TextBlock Text="Recent Sessions" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Border
                    Visibility="{x:Bind ViewModel.HasRecentSessions, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24,20">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE81C;"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="No session history recorded yet" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="Start a game session to log process ID, start/end times, duration, and outcome."
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsRepeater
                    ItemsSource="{x:Bind ViewModel.RecentSessions}"
                    Visibility="{x:Bind ViewModel.HasRecentSessions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:GameSession">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <controls:GameCoverImage
                                        Width="40"
                                        Height="40"
                                        CornerRadius="6"
                                        ImageUrl="{x:Bind CoverImageUrl, Mode=OneWay}"
                                        FallbackInitials="{x:Bind Initials}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Text="{x:Bind GameName}"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind StartedAtShortDisplay}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="PID" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind ProcessIdDisplay, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="DURATION" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind DurationDisplay, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="OUTCOME" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind Outcome, Mode=OneWay}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="5"
                                        VerticalAlignment="Center"
                                        Content="Open Monitor"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Click="OpenSessionMonitorButton_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

