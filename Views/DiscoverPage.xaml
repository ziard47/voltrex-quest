<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="voltrex_quest.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:voltrex_quest.Controls"
    xmlns:vm="using:voltrex_quest.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24,20,0" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header & Filter Bar -->
        <Grid Margin="0,0,12,0" ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Discover Games" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                <TextBlock
                    Text="{x:Bind ViewModel.ResultsSummary, Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
                <TextBox
                    Width="250"
                    PlaceholderText="Search by name, alias, or exe..."
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox
                    Width="175"
                    ItemsSource="{x:Bind ViewModel.PlatformFilters}"
                    SelectedItem="{x:Bind ViewModel.SelectedPlatformFilter, Mode=TwoWay}"
                    DisplayMemberPath="Label" />

                <ComboBox
                    Width="165"
                    ItemsSource="{x:Bind ViewModel.ThemeFilters}"
                    SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <!-- Loading State -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="38" Height="38" />
            <TextBlock
                Text="Loading Discord Quest game catalog..."
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Error State -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14"
            MaxWidth="460"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Error"
                Title="Catalog Load Failed"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <Button
                Content="Retry"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.RetryLoadCommand}" />
        </StackPanel>

        <!-- Empty State -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Glyph="&#xE721;"
                FontSize="32"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                Text="No matching games found"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Try adjusting your search query, platform filter, or theme selection."
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
            <Button
                Content="Clear Filters"
                HorizontalAlignment="Center"
                Margin="0,6,0,0"
                Command="{x:Bind ViewModel.ClearFiltersCommand}" />
        </StackPanel>

        <!-- Virtualized Game Catalog Grid -->
        <GridView
            x:Name="CatalogGridView"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Games}"
            SelectionMode="None"
            IsItemClickEnabled="False"
            Padding="0,0,0,24"
            Loaded="CatalogGridView_Loaded"
            SizeChanged="CatalogGridView_SizeChanged"
            ContainerContentChanging="CatalogGridView_ContainerContentChanging"
            Visibility="{x:Bind ViewModel.ShowContentGrid, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0,0,12,12" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:DiscoverGameItemViewModel">
                    <Border
                        Height="288"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="124" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Artwork + Supported Status Pill -->
                            <Grid Grid.Row="0">
                                <controls:GameCoverImage
                                    CornerRadius="6"
                                    ImageUrl="{x:Bind Game.CoverImageUrl}"
                                    FallbackInitials="{x:Bind Game.Initials}" />

                                <Border
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="8"
                                    Padding="7,3"
                                    CornerRadius="4"
                                    Background="#D916181D"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1">
                                    <TextBlock
                                        Text="{x:Bind Game.SupportedStatusLabel}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>

                            <!-- Game Name & Metadata -->
                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock
                                    Text="{x:Bind Game.Name}"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="WrapWholeWords" />

                                <TextBlock
                                    Text="{x:Bind Game.ThemesSummary}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Text="{x:Bind Game.PrimaryExecutableDisplay}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Action Row -->
                            <Grid Grid.Row="2" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    HorizontalAlignment="Stretch"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind CanAdd, Mode=OneWay}"
                                    Tag="{x:Bind}"
                                    Click="AddGameButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            Glyph="&#xE710;"
                                            FontSize="12"
                                            Visibility="{x:Bind CanAdd, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <FontIcon
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            Glyph="&#xE73E;"
                                            FontSize="12"
                                            Visibility="{x:Bind IsInLibrary, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{x:Bind AddButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Grid.Column="1"
                                    Tag="{x:Bind}"
                                    Click="DetailsButton_Click"
                                    ToolTipService.ToolTip="View game metadata">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE946;" FontSize="13" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>

