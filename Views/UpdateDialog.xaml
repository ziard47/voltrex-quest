<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="voltrex_quest.Views.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CloseButtonText="Close"
    DefaultButton="Primary"
    Loaded="UpdateDialog_Loaded"
    Closed="UpdateDialog_Closed"
    PrimaryButtonClick="UpdateDialog_PrimaryButtonClick"
    SecondaryButtonClick="UpdateDialog_SecondaryButtonClick">

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border
                    Width="36"
                    Height="36"
                    Background="#000000"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Image
                        Source="ms-appx:///Assets/VoltrexQuestLogo.png"
                        Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Voltrex Quest Updates" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="GitHub Releases · ziard47/voltrex-quest"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <StackPanel MinWidth="440" Spacing="14">
        <!-- Checking State -->
        <StackPanel
            x:Name="CheckingPanel"
            Orientation="Horizontal"
            Spacing="14"
            Padding="4,8"
            Visibility="Visible">
            <ProgressRing IsActive="True" Width="24" Height="24" />
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Checking for updates..." Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Name="CheckingSubtitleText"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Status Banner -->
        <InfoBar
            x:Name="StatusBanner"
            IsOpen="False"
            IsClosable="False"
            Visibility="Collapsed" />

        <!-- Release Details & Release Notes -->
        <StackPanel
            x:Name="ReleaseDetailsPanel"
            Spacing="10"
            Visibility="Collapsed">
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock
                            x:Name="ReleaseTitleText"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ReleaseMetaText"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4">
                        <TextBlock
                            x:Name="VersionBadgeText"
                            Style="{ThemeResource CaptionTextBlockStyle}" />
                    </Border>
                </Grid>
            </Border>

            <StackPanel Spacing="6">
                <TextBlock
                    Text="Release Notes"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                    <ScrollViewer
                        MaxHeight="210"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="ReleaseNotesText"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <TextBlock
                x:Name="InstallerAssetText"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Installer Download Progress -->
        <StackPanel
            x:Name="DownloadPanel"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock
                x:Name="DownloadStatusText"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="Preparing download..." />
            <ProgressBar
                x:Name="DownloadProgressBar"
                Minimum="0"
                Maximum="100"
                Value="0"
                IsIndeterminate="True" />
        </StackPanel>
    </StackPanel>
</ContentDialog>

