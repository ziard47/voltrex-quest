<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="voltrex_quest.Controls.GameCoverImage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#1A1D23" CornerRadius="{x:Bind CornerRadius, Mode=OneWay}">
        <!-- Clean fallback artwork when cover_image_hash is absent or offline -->
        <StackPanel
            x:Name="FallbackPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Padding="12">
            <FontIcon
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Glyph="&#xE7FC;"
                FontSize="26"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="InitialsText"
                Text="{x:Bind FallbackInitials, Mode=OneWay}"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <Image
            x:Name="CoverImage"
            Stretch="UniformToFill"
            Opacity="0"
            ImageOpened="CoverImage_ImageOpened"
            ImageFailed="CoverImage_ImageFailed" />
    </Grid>
</UserControl>

